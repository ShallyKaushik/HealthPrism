# HealthPrism Production Environment Template
# Copy this to your hosting provider's "Environment Variables" section

# --- AUTH & SECURITY ---
SECRET_KEY=generate-a-long-random-string
JWT_SECRET_KEY=generate-another-random-string
FRONTEND_URL=https://your-frontend-domain.vercel.app

# --- DATABASE ---
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/HealthPrism?retryWrites=true&w=majority

# --- AI PROVIDER KEYS ---
OPENAI_API_KEY=sk-proj-your-openai-key
GEMINI_API_KEY=AIzaSy-your-gemini-key
GROQ_API_KEY=gsk-your-groq-key

# --- OPTIONAL ---
PORT=5000
